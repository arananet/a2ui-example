# =============================================================================
# A2UI Unsplash Photo Explorer — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
#
# For Railway deployment, set these as Railway service variables
# (Settings → Variables) — do NOT use a .env file in production.
# =============================================================================

# -----------------------------------------------------------------------------
# Google ADK / Gemini Configuration
# -----------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# Google Cloud Credentials
#
# LOCAL DEVELOPMENT:
#   Leave GOOGLE_APPLICATION_CREDENTIALS_JSON unset.
#   Run: gcloud auth application-default login
#   The SDK will use your local credentials automatically.
#
# RAILWAY (and any containerised deployment):
#   Set GOOGLE_APPLICATION_CREDENTIALS_JSON to the full contents of your
#   GCP service account key JSON file. The app will write it to a temp file
#   at startup so the Google SDK can find it via Application Default Credentials.
#
#   How to generate a service account key:
#     gcloud iam service-accounts create a2ui-photo-explorer \
#       --display-name="A2UI Photo Explorer"
#     gcloud projects add-iam-policy-binding YOUR_PROJECT_ID \
#       --member="serviceAccount:a2ui-photo-explorer@YOUR_PROJECT_ID.iam.gserviceaccount.com" \
#       --role="roles/aiplatform.user"
#     gcloud iam service-accounts keys create sa-key.json \
#       --iam-account=a2ui-photo-explorer@YOUR_PROJECT_ID.iam.gserviceaccount.com
#
#   Then paste the entire contents of sa-key.json as the value below (one line).
# -----------------------------------------------------------------------------
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# -----------------------------------------------------------------------------
# Agent URL
# Set to your Railway service public URL after first deploy, e.g.:
#   AGENT_URL=https://a2ui-photo-explorer.up.railway.app
# Use http://127.0.0.1:8001 for local development.
# -----------------------------------------------------------------------------
AGENT_URL=http://127.0.0.1:8001

# -----------------------------------------------------------------------------
# Unsplash API Credentials
# Register your app at: https://unsplash.com/developers
# Use the "Access Key" (not the Secret Key) for API calls.
# -----------------------------------------------------------------------------
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# -----------------------------------------------------------------------------
# PORT (Railway only — do not set locally)
# Railway injects this automatically. Uvicorn binds to it via Procfile.
# Do not set this in your local .env file.
# -----------------------------------------------------------------------------
# PORT=8080
