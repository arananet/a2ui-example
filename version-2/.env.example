# =============================================================================
# A2UI Unsplash Photo Explorer — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Google ADK / Gemini Configuration
# -----------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
MODEL=gemini-2.5-flash

# The public URL where this agent is hosted.
# Use http://127.0.0.1:8001 for local development.
AGENT_URL=http://127.0.0.1:8001

# -----------------------------------------------------------------------------
# Unsplash API Credentials
# Register your app at: https://unsplash.com/developers
# Use the "Access Key" (not the Secret Key) for API calls.
# -----------------------------------------------------------------------------
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
